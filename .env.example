# Copy this file to .env before running docker compose. Never commit the real .env file.
POSTGRES_USER=jmindops_owner
POSTGRES_PASSWORD=
POSTGRES_DB=jmindops
UI_PORT=3000
APP_DB_PASSWORD=
# Required only when DATABASE_TOOL_ENABLED=true. This account receives SELECT
# on the explicitly allowlisted business tables and no access to auth/audit data.
DB_TOOL_PASSWORD=
APP_JWT_SECRET=
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# Configure at least the model provider used by the Agent you create.
DEEPSEEK_API_KEY=
ZHIPUAI_API_KEY=
GOOGLE_GENAI_API_KEY=

# Optional capabilities
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_TOOL_ENABLED=false
DATABASE_TOOL_ENABLED=false
DATABASE_TOOL_ALLOWED_RELATIONS=agent,chat_session,chat_message,knowledge_base,document,chunk_bge_m3
# 本地/Compose 文件工具均默认关闭；启用后只能访问配置的隔离工作区。
FILESYSTEM_TOOL_ENABLED=false
FILESYSTEM_TOOL_BASE_PATH=./data/mcp-workspace
MCP_CLIENT_ENABLED=false
RAG_EMBEDDING_BASE_URL=http://host.docker.internal:11434
RAG_EMBEDDING_MODEL=bge-m3
RAG_INDEX_PIPELINE_VERSION=tika-flexmark-chunk-v1
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_NORMALIZATION=none
# 在线回答先召回 20 个候选，经重排后保留 5 个；阈值应只用开发集校准。
RAG_ANSWER_TOP_K=5
RAG_CANDIDATE_TOP_K=20
RAG_EVIDENCE_GATE_ENABLED=true
RAG_MINIMUM_RERANK_SCORE=0.05
RAG_RERANKER_PROVIDER=none
# GPU/vLLM：provider=http，profile=rerank；CPU/TEI：provider=tei，profile=rerank-cpu。
RAG_RERANKER_BASE_URL=http://reranker:8000
RAG_RERANKER_ENDPOINT=/v1/rerank
RAG_RERANKER_TEI_ENDPOINT=/rerank
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_TEI_MODEL=BAAI/bge-reranker-base
RAG_RERANKER_TIMEOUT_SECONDS=30
RAG_RERANKER_PORT=8001
RAG_RERANKER_MAX_MODEL_LEN=4096
RERANKER_VLLM_IMAGE=vllm/vllm-openai:latest
RERANKER_TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# Recover committed-but-not-dispatched Agent generations. Values are in seconds/milliseconds.
GENERATION_PENDING_REDISPATCH_AFTER_SECONDS=15
GENERATION_RUNNING_TIMEOUT_SECONDS=600
GENERATION_RECOVERY_BATCH_SIZE=20
GENERATION_RECOVERY_INITIAL_DELAY_MS=15000
GENERATION_RECOVERY_FIXED_DELAY_MS=15000
